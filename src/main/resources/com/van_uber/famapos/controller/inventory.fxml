<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.van_uber.famapos.controller.InventoryController" stylesheets="@main.css" styleClass="root-pane" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- LEFT SIDE: Actions Sidebar -->
    <VBox spacing="15" minWidth="270" maxWidth="300" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 20;">
        <Label text="Almacén" styleClass="program-logo-text" />
        <Region minHeight="20" />
        <ToggleButton fx:id="btnFilterExpiration" text="Caducidad" onAction="#onExpirationAlerts" styleClass="filter-toggle-button" maxWidth="9999" wrapText="true" />
        <ToggleButton fx:id="btnFilterStock" text="Stock" onAction="#onLowStockAlerts" styleClass="filter-toggle-button" maxWidth="9999" wrapText="true" />
        <Button text="Nuevo Producto" onAction="#onNewProduct" styleClass="nav-button" maxWidth="9999" />
        <Button text="Exportar a CSV" onAction="#onExportCsv" styleClass="nav-button" style="-fx-text-fill: #2ecc71;" maxWidth="9999" />
        <Button text="Resumen de Ventas" onAction="#onSummary" styleClass="nav-button" style="-fx-text-fill: #3498db; -fx-font-weight: bold;" maxWidth="9999" />
        <Button text="Editar Producto" onAction="#onEditProduct" styleClass="nav-button" maxWidth="9999" />
        <Button text="Cambiar Estado" onAction="#onToggleStatus" styleClass="button" style="-fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5; -fx-background-color: #f1c40f; -fx-text-fill: #000000; -fx-font-weight: bold;" maxWidth="9999" />
        <Button text="Eliminar Producto" onAction="#onDeleteProduct" styleClass="button" style="-fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5; -fx-background-color: #e74c3c; -fx-text-fill: #ffffff; -fx-font-weight: bold;" maxWidth="9999" />
        
        <Region VBox.vgrow="ALWAYS" />
        
        <Button text="Volver a Ventas" onAction="#onBackToSales" styleClass="nav-button" maxWidth="9999" />
    </VBox>

    <!-- RIGHT SIDE: Data Table -->
    <VBox HBox.hgrow="ALWAYS" spacing="10">
        <HBox spacing="10">
            <TextField fx:id="searchField" promptText="Buscar producto por nombre, código o categoría..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
            <Button text="🔍" styleClass="icon-button"/>
        </HBox>
        
        <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="sales-table">
            <columns>
                <TableColumn fx:id="colBarcode" text="Código" prefWidth="160"/>
                <TableColumn fx:id="colName" text="Producto" prefWidth="280"/>
                <TableColumn fx:id="colCategory" text="Categoría" prefWidth="150"/>
                <TableColumn fx:id="colLaboratory" text="Laboratorio" prefWidth="200"/>
                <TableColumn fx:id="colCompounds" text="Compuesto(s)" prefWidth="260"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
                <TableColumn fx:id="colThreshold" text="Umbral" prefWidth="90"/>
                <TableColumn fx:id="colExpiration" text="Caducidad" prefWidth="130"/>
                <TableColumn fx:id="colCost" text="Costo" prefWidth="100"/>
                <TableColumn fx:id="colPrice" text="Precio" prefWidth="100"/>
                <TableColumn fx:id="colActive" text="Estado" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
