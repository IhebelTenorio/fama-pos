<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.van_uber.famapos.controller.HistoryController" stylesheets="@main.css" styleClass="root-pane" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- LEFT SIDE: Actions Sidebar -->
    <VBox spacing="10" minWidth="280" maxWidth="300" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;">
        <Label text="Historial" styleClass="program-logo-text" />
        <Region minHeight="10" />
        
        <Label text="Buscar por Folio:" styleClass="label" />
        <TextField fx:id="searchField" promptText="Buscar por ID (Folio)..." styleClass="search-field" />
        
        <Label text="Rango de Fechas:" styleClass="label" />
        <DatePicker fx:id="startDatePicker" promptText="Desde fecha..." maxWidth="9999"/>
        <DatePicker fx:id="endDatePicker" promptText="Hasta fecha..." maxWidth="9999"/>
        
        <Label text="Presets rápidos:" style="-fx-font-size: 12px; -fx-text-fill: #888;" />
        <GridPane hgap="5" vgap="5">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <Button text="Hoy" onAction="#onPresetToday" styleClass="button" maxWidth="9999" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Button text="Semana" onAction="#onPresetWeek" styleClass="button" maxWidth="9999" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button text="Mes" onAction="#onPresetMonth" styleClass="button" maxWidth="9999" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Button text="Año" onAction="#onPresetYear" styleClass="button" maxWidth="9999" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        
        <Button text="Limpiar Filtros" onAction="#onClearFilters" styleClass="nav-button" maxWidth="9999" />
        
        <Region VBox.vgrow="ALWAYS" />
        
        <Button text="Exportar Tickets (CSV)" onAction="#onExportCsv" styleClass="nav-button" style="-fx-text-fill: #2ecc71;" maxWidth="9999" />
        <Button text="Exportar Detalle Ventas (CSV)" onAction="#onExportDetailedSalesCsv" styleClass="nav-button" style="-fx-text-fill: #27ae60; -fx-font-size: 13px;" maxWidth="9999" />
        
        <Region VBox.vgrow="ALWAYS" />
        <Button text="Volver a Ventas" onAction="#onBackToSales" styleClass="nav-button" maxWidth="9999" />
    </VBox>

    <!-- RIGHT SIDE: Data Table -->
    <VBox HBox.hgrow="ALWAYS" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Doble clic en un ticket para ver sus detalles o reembolsarlo." style="-fx-text-fill: #666666; -fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Ver Detalles" onAction="#onViewDetails" styleClass="nav-button" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        </HBox>
        
        <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS" styleClass="sales-table">
            <columns>
                <TableColumn fx:id="colId" text="Folio (ID)" prefWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
                <TableColumn fx:id="colHora" text="Hora" prefWidth="150"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
