<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.van_uber.famapos.controller.LoginController" stylesheets="@main.css" styleClass="root-pane">
    <children>
        <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" alignment="CENTER">
            <VBox alignment="CENTER" spacing="20" maxWidth="350" maxHeight="450" styleClass="login-box">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>
                
                <StackPane prefHeight="80">
                    <Label text="FaMa-POS" styleClass="program-logo-text" />
                </StackPane>

                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Usuario:" styleClass="label"/>
                    <TextField fx:id="userField" styleClass="input-field" />
                </VBox>

                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Contraseña:" styleClass="label"/>
                    <PasswordField fx:id="passwordField" styleClass="input-field" />
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-label" />

                <HBox alignment="CENTER_RIGHT" prefWidth="200" spacing="10">
                    <Button text="Salir" onAction="#onCloseApp" styleClass="button" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-cursor: hand; -fx-font-size: 16px;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Ingresar" onAction="#handleLogin" styleClass="login-button" />
                </HBox>
            </VBox>
        </VBox>

        <VBox AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0" alignment="CENTER">
            <ImageView fitWidth="120" preserveRatio="true">
                <image>
                    <Image url="@/images/Vanuber_Logo.png" />
                </image>
            </ImageView>
        </VBox>
    </children>
</AnchorPane>
