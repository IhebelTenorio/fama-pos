<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.van_uber.famapos.controller.CheckoutModalController" stylesheets="@main.css" spacing="20" alignment="CENTER">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Cobrar Venta" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <GridPane hgap="15" vgap="20" alignment="CENTER">
        <Label text="Total a Cobrar:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 18px;"/>
        <Label fx:id="totalLabel" text="\$ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        
        <Label text="Monto Recibido:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 18px;"/>
        <TextField fx:id="receivedField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 20px;" prefWidth="150"/>
        
        <Label text="Cambio:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 18px;"/>
        <Label fx:id="changeLabel" text="\$ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" minHeight="20"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Cancelar" onAction="#onCancel" styleClass="button" prefWidth="120" style="-fx-font-size: 16px;"/>
        <Button text="Confirmar y Cobrar" onAction="#onConfirm" styleClass="button" prefWidth="200" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
    </HBox>
</VBox>
