<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.van_uber.famapos.controller.SalesController" stylesheets="@main.css" styleClass="root-pane" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- LEFT SIDE: Staging / Cart -->
    <VBox HBox.hgrow="ALWAYS" spacing="10" minWidth="500">
        <HBox spacing="10">
            <TextField fx:id="searchField" promptText="Click para buscar" styleClass="search-field" HBox.hgrow="ALWAYS"/>
            <Button text="🔍" onAction="#onSearch" styleClass="icon-button"/>
        </HBox>
        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" styleClass="sales-table">
            <columns>
                <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="150"/>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="250"/>
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="120"/>
                <TableColumn fx:id="colLaboratorio" text="Laboratorio" prefWidth="150"/>
                <TableColumn fx:id="colCompuestos" text="Compuesto(s) y gramaje(s)" prefWidth="250"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- RIGHT SIDE: Controls & Totals -->
    <VBox spacing="15" minWidth="300" maxWidth="400">
        <HBox alignment="TOP_RIGHT">
            <Button text="Sesión" onAction="#onSession" styleClass="nav-button"/>
        </HBox>

        <VBox spacing="5">
            <Label text="Seleccionado:" styleClass="label"/>
            <Label fx:id="selectedProductLabel" styleClass="black-box-label" prefWidth="9999" minHeight="50"/>
        </VBox>

        <VBox alignment="CENTER" spacing="5">
            <Label text="Cantidad:" styleClass="label"/>
            <HBox alignment="CENTER" spacing="15">
                <Button text="-" onAction="#onMinus" styleClass="circle-button, minus-button"/>
                <Label fx:id="selectedQuantityLabel" text="0" styleClass="black-box-label, large-text" minWidth="100" alignment="CENTER_RIGHT"/>
                <Button text="+" onAction="#onPlus" styleClass="circle-button, plus-button"/>
            </HBox>
        </VBox>

        <VBox spacing="5" VBox.vgrow="SOMETIMES" minHeight="100" maxHeight="200">
            <Label text="Compuestos:" styleClass="label"/>
            <TableView fx:id="compuestosTable" VBox.vgrow="ALWAYS" styleClass="compuestos-table">
                <columns>
                    <TableColumn fx:id="colCompuesto" text="Compuesto" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="10" bottom="10"/></padding>
            <Button text="Historial" onAction="#onHistory" styleClass="nav-button" HBox.hgrow="ALWAYS" maxWidth="9999"/>
            <Button text="Almacén" onAction="#onWarehouse" styleClass="nav-button" HBox.hgrow="ALWAYS" maxWidth="9999"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <VBox spacing="5">
            <Label text="Total:" styleClass="label"/>
            <Label fx:id="totalLabel" text="\$ 0.00" styleClass="black-box-label, huge-text" prefWidth="9999" alignment="CENTER_RIGHT" minHeight="80"/>
        </VBox>

        <GridPane hgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="66.6"/>
                <ColumnConstraints percentWidth="33.4"/>
            </columnConstraints>
            <Button text="Efectivo" onAction="#onCash" styleClass="pay-cash-button" maxWidth="9999" GridPane.columnIndex="0"/>
            <Button text="Tarjeta" onAction="#onCard" styleClass="pay-card-button" maxWidth="9999" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>
</HBox>
